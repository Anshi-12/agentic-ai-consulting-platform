# Copy to .env and edit. Never commit .env.

# ---- Provider mode --------------------------------------------------------
# mock = offline deterministic responses (default; no keys needed)
# live = real model calls using the models below
LLM_PROVIDER_MODE=mock

# ---- Model routing: "<provider>:<model-id>" (providers: anthropic, openai) ----
# Unset roles inherit MODEL_PRIMARY in live mode.
MODEL_PRIMARY=anthropic:claude-opus-5-5
MODEL_LIGHT=anthropic:claude-haiku-5-5
MODEL_SYNTHESIS=anthropic:claude-sonnet-5-5
MODEL_FALLBACK=openai:gpt-4o-mini

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1   # any OpenAI-compatible server works

# ---- Resilience -------------------------------------------------------------
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_BACKOFF_BASE_SECONDS=1
LLM_BACKOFF_MAX_SECONDS=20
LLM_STRUCTURED_REPAIR_ATTEMPTS=1
AGENT_TIMEOUT_SECONDS=180
# AGENT_TIMEOUT_STRATEGY=240           # per-agent override (CLIENT_DISCOVERY, PROBLEM_STRUCTURING, ...)
NODE_MAX_ATTEMPTS=2
MAX_QA_ITERATIONS=2
MAX_TOOL_CALLS_PER_AGENT=12
MAX_TOOL_CALLS_PER_RUN=80
LOW_CONFIDENCE_THRESHOLD=0.55

# ---- Persistence -------------------------------------------------------------
CHECKPOINT_BACKEND=memory               # memory | sqlite
CHECKPOINT_SQLITE_PATH=data/checkpoints.sqlite
RUN_STORE_PATH=                         # e.g. data/runs  (empty = in-memory run records)

# ---- Security ----------------------------------------------------------------
INJECTION_POLICY=quarantine             # quarantine | flag
DEV_ALLOWED_PROJECTS=*                  # DEV ONLY placeholder auth for the standalone API

# ---- LangSmith observability -------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=consulting-ai-group1
TRACE_ALLOW_CLIENT_DATA=false           # keep false unless the deployment authorizes sending client data

LOG_LEVEL=INFO
