{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Demo: full engagement (mock)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_demo.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Demo: interactive (you approve)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_demo.py",
      "args": ["--interactive", "--vague"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Demo: QA rework loop",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run_demo.py",
      "args": ["--scenario", "qa_failure_once"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "API server (uvicorn, /docs)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["backend.api.app:app", "--reload", "--port", "8000"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Evaluation suite",
      "type": "debugpy",
      "request": "launch",
      "module": "backend.evaluation.run_eval",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Pytest: all",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
